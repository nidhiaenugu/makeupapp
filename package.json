{
  "name": "glowmatch",
  "version": "1.0.0",
  "private": false,
  "description": "GlowMatch — a personalized makeup, skincare and haircare recommendation engine with an explainable matching algorithm and a public REST API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check": "npm run typecheck && npm run test && npm run validate:catalog",
    "build:standalone": "tsx scripts/build-standalone.ts",
    "smoke:standalone": "node scripts/smoke-standalone.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "playwright": "^1.49.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
